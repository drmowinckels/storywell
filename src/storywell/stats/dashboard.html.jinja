<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
:root{
  --bg:#10151c; --panel:#19212d; --ink:#e9ecf1; --muted:#9aa6b2;
  --line:#2a3543; --amber:#e0a85e;
}
*{box-sizing:border-box}
body{margin:0;color:var(--ink);
  background:radial-gradient(1100px 560px at 72% -12%, #1c2632, var(--bg)) fixed;
  font:16px/1.55 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif}
.page{max-width:1000px;margin:0 auto;padding:48px 24px 56px}
.masthead h1{font-size:2rem;margin:0 0 4px;font-weight:650;letter-spacing:-.01em}
.masthead .sub{color:var(--muted);margin:0 0 28px}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:14px;margin-bottom:22px}
.stat{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:18px 20px}
.stat .num{display:block;font-size:1.9rem;font-weight:650;color:var(--amber);font-variant-numeric:tabular-nums}
.stat .lbl{color:var(--muted);font-size:.85rem}
.pace{color:var(--muted);margin:0 0 26px}
.pace strong{color:var(--ink)}
.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
.card{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:18px 20px;margin:0}
.card.wide{grid-column:1/-1}
figcaption{font-weight:600;margin-bottom:12px;font-size:.95rem}
.chart .bar{fill:var(--amber)}
.chart .bar-label{fill:var(--muted);font-size:12px}
.chart .bar-value{fill:var(--ink);font-size:12px;font-variant-numeric:tabular-nums}
.col-value{fill:var(--ink);font-size:12px;font-variant-numeric:tabular-nums}
.col-label{fill:var(--muted);font-size:12px}
.hm-axis{fill:var(--muted);font-size:11px}
.stem{stroke:var(--amber);stroke-width:2}
.lolli{fill:var(--amber)}
.donut-total{fill:var(--ink);font-size:1.5rem;font-weight:650}
.donut-sub{fill:var(--muted);font-size:11px}
.donut-wrap,.stacked{display:flex;gap:18px;align-items:center;flex-wrap:wrap}
.stacked{flex-direction:column;align-items:stretch;gap:10px}
.donut{flex:0 0 150px;max-width:150px}
.legend{list-style:none;margin:0;padding:0;display:grid;gap:7px}
.legend li{display:flex;align-items:center;gap:9px;font-size:.86rem;color:var(--muted)}
.legend .swatch{width:12px;height:12px;border-radius:3px;flex:0 0 auto}
.legend b{color:var(--ink);font-weight:600}
.traits{display:grid;grid-template-columns:1fr 1fr;gap:24px}
.trait-h{color:var(--muted);font-size:.82rem;margin-bottom:10px}
.pct-list{display:grid;gap:9px}
.pct-row{display:grid;grid-template-columns:1fr 90px 38px;align-items:center;gap:10px;font-size:.86rem}
.pct-label{color:var(--muted)}
.pct-track{background:#222c39;border-radius:6px;height:10px;overflow:hidden}
.pct-fill{display:block;height:100%;background:var(--amber);border-radius:6px}
.pct-val{color:var(--ink);text-align:right;font-variant-numeric:tabular-nums}
.empty{color:var(--muted);font-style:italic;margin:6px 0}
.foot{margin-top:30px;color:var(--muted);font-size:.82rem;border-top:1px solid var(--line);padding-top:16px}
.foot p{margin:4px 0}
@media (max-width:640px){.grid{grid-template-columns:1fr}.traits{grid-template-columns:1fr}}
@media print{
  body{background:#fff;color:#111}
  .stat,.card{background:#fff;border-color:#ddd;break-inside:avoid}
  .stat .num{color:#a36b1e}.chart .bar{fill:#caa15f}
  .pct-track{background:#eee}.pct-fill{background:#caa15f}
}
</style>
</head>
<body>
<main class="page">
  <header class="masthead">
    <h1>{{ title }}</h1>
    <p class="sub">Built by Storywell from your StoryGraph export — offline, your data never leaves your device.</p>
  </header>

  <section class="cards">
    <div class="stat"><span class="num">{{ summary.read_books }}</span><span class="lbl">books read</span></div>
    <div class="stat"><span class="num">{{ summary.total_finishes }}</span><span class="lbl">finishes, incl. re-reads</span></div>
    {% if summary.mean_rating is not none %}
    <div class="stat"><span class="num">{{ "%.2f"|format(summary.mean_rating) }}&#9733;</span><span class="lbl">average rating</span></div>
    {% endif %}
    {% if summary.latest_year is not none %}
    <div class="stat"><span class="num">{{ summary.latest_year_books }}</span><span class="lbl">finished in {{ summary.latest_year }}</span></div>
    {% endif %}
  </section>

  {% if pace.count %}
  <p class="pace">Median <strong>{{ "%g"|format(pace.median_days) }}</strong> days to finish, from {{ pace.count }} dated reads. Fastest: {{ pace.shortest.title }} ({{ pace.shortest.days }}d) · slowest: {{ pace.longest.title }} ({{ pace.longest.days }}d).</p>
  {% endif %}

  <section class="grid">
    <figure class="card"><figcaption>Books finished per year</figcaption>{{ charts.year|safe }}</figure>
    <figure class="card"><figcaption>Star ratings</figcaption>{{ charts.rating|safe }}</figure>
    <figure class="card wide"><figcaption>When you read</figcaption>{{ charts.heatmap|safe }}</figure>
    <figure class="card"><figcaption>Formats</figcaption>{{ charts.format|safe }}</figure>
    <figure class="card"><figcaption>Reading pace</figcaption>{{ charts.pace|safe }}</figure>
    <figure class="card"><figcaption>Top moods</figcaption>{{ charts.moods|safe }}</figure>
    <figure class="card"><figcaption>Most-read authors</figcaption>{{ charts.authors|safe }}</figure>
    <figure class="card wide"><figcaption>Your character preferences</figcaption>{{ charts.taste|safe }}</figure>
  </section>

  <footer class="foot">
    <p>StoryGraph exports don't include page counts, genres, or publication dates, so those stats aren't shown.</p>
    <p>Generated by Storywell · {{ summary.read_books }} books · made entirely offline.</p>
  </footer>
</main>
<script type="application/json" id="storywell-stats">{{ data_json|safe }}</script>
</body>
</html>
